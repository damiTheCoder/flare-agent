# MicroBalance / Flare Agent — deployment configuration
# Copy to .env, fill the secrets, then keep the file out of version control
# (it is gitignored and excluded from the Docker build context).

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL. DATABASE_URL wins over FLARE_DATABASE_URL when both are set.
# postgres:// and postgresql:// URLs are normalised to the psycopg driver.
DATABASE_URL=postgresql://microbalance:change-me@localhost:5432/microbalance

# DeepSeek (recommended): the validator switches to the openai-compatible
# protocol and fills the base URL / model automatically.
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenAI alternative (leave the DeepSeek key empty):
# OPENAI_API_KEY=sk-your-openai-key
# FLARE_MODEL_NAME=gpt-4o-mini
# FLARE_MODEL_BASE_URL=https://api.openai.com/v1

# Anthropic alternative:
# FLARE_MODEL_PROVIDER=anthropic
# FLARE_MODEL_API_KEY=sk-ant-your-key
# FLARE_MODEL_NAME=claude-sonnet-4-5
# FLARE_MODEL_BASE_URL=https://api.anthropic.com

# Local Ollama / vLLM:
# FLARE_MODEL_PROVIDER=openai
# FLARE_MODEL_BASE_URL=http://localhost:11434/v1
# FLARE_MODEL_API_KEY=ollama
# FLARE_MODEL_NAME=llama3.1

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

FLARE_ENV=production
FLARE_LOG_LEVEL=INFO
# Same-origin SPA: keep empty unless another origin calls the API.
FLARE_CORS_ORIGINS=[]

# Session/task storage: memory | sqlite | redis (redis for multi-instance)
FLARE_TASK_STORE=redis
FLARE_REDIS_URL=redis://localhost:6379/0

# Optional bearer token for the OpenAI-compatible API (/v1/*).
# Leave empty for same-origin SPA use; set it for machine clients.
# FLARE_API_KEY=

# Voice replies (TTS). Point this at any OpenAI-compatible speech endpoint;
# the local microbalance-tts Kokoro server listens on 8023.
FLARE_TTS_ENABLED=true
FLARE_TTS_URL=http://127.0.0.1:8023/v1/audio/speech
FLARE_TTS_VOICE=af_bella
FLARE_TTS_SPEED=0.88

# Auth gate: the landing page + Google OAuth. A session secret enables the
# gate; Google needs an OAuth client (authorized redirect URI must be
# ${FLARE_APP_BASE_URL}/auth/google/callback).
FLARE_SESSION_SECRET=change-me-to-a-long-random-string
FLARE_APP_BASE_URL=http://localhost:8000
# FLARE_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# FLARE_GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
# Local demo sign-in (only for private machines; never in public deployments)
FLARE_AUTH_ALLOW_LOCAL=false

# Harness tools: read/write/edit/glob/grep/bash are bound to this directory.
# FLARE_WORKSPACE_DIR=/app
# "off" disables the tool approval gate (local only); read|write|destructive.
# FLARE_APPROVAL_REQUIRE_LEVEL=destructive

# ---------------------------------------------------------------------------
# Security hardening
# ---------------------------------------------------------------------------

# Security headers (CSP, frame denial, nosniff, referrer policy) — on by default.
FLARE_SECURITY_HEADERS=true
# Reject oversized request bodies before they reach a handler (25 MiB).
FLARE_MAX_REQUEST_BYTES=26214400

# Sliding-window limits per client IP. Defaults to on in production.
FLARE_RATE_LIMIT_ENABLED=true
FLARE_RATE_LIMIT_PER_MINUTE=120
FLARE_RATE_LIMIT_CHAT_PER_MINUTE=20
# Only enable behind a proxy that overwrites X-Forwarded-For.
FLARE_RATE_LIMIT_TRUST_PROXY=false

# Swagger / OpenAPI docs. Defaults to off in production.
FLARE_DOCS_ENABLED=false

# Optional HTTP Basic gate for the whole UI + API (put it behind HTTPS).
# FLARE_UI_AUTH_USERNAME=admin
# FLARE_UI_AUTH_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Approval gate for write/destructive tools (read | write | destructive)
# FLARE_APPROVAL_REQUIRE_LEVEL=destructive
# FLARE_APPROVAL_BACKEND=local
# FLARE_APPROVAL_TIMEOUT=300

# Where the container finds the built SPA (the Dockerfile sets this already)
# FLARE_WEB_DIST=/app/static

# Object storage for document uploads
# FLARE_OBJECT_STORE_ENDPOINT=http://localhost:9000
# FLARE_OBJECT_STORE_ACCESS_KEY=minioadmin
# FLARE_OBJECT_STORE_SECRET_KEY=minioadmin

# MCP servers (JSON array)
# FLARE_MCP_SERVERS=[{"name":"echo","url":"http://localhost:9001/mcp","transport":"streamable_http","headers":{},"enabled":true}]
