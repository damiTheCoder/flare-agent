# MicroBalance / Flare Agent — deployment configuration
# Copy to .env for local runs, or pass with `docker run --env-file .env`.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL. Both names work; DATABASE_URL wins when both are set.
# postgres:// and postgresql:// URLs are normalised to the psycopg driver.
DATABASE_URL=postgresql://microbalance:microbalance@localhost:5432/microbalance
# FLARE_DATABASE_URL=postgresql://microbalance:microbalance@localhost:5432/microbalance

# The real model. Any OpenAI-compatible endpoint works.
OPENAI_API_KEY=sk-your-key
FLARE_MODEL_PROVIDER=openai
FLARE_MODEL_NAME=gpt-4o-mini
FLARE_MODEL_BASE_URL=https://api.openai.com/v1

# DeepSeek alternative (leave OPENAI_API_KEY empty and set these instead):
# DEEPSEEK_API_KEY=sk-your-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

FLARE_ENV=production
FLARE_LOG_LEVEL=INFO
# JSON array in production, e.g. '["https://app.example.com"]'
FLARE_CORS_ORIGINS=["*"]

# Session/task storage: memory | sqlite | redis (redis for multi-instance)
FLARE_TASK_STORE=redis
FLARE_REDIS_URL=redis://localhost:6379/0

# Optional: require a bearer token on the OpenAI-compatible API
# FLARE_API_KEY=sk-local-admin

# Approval gate for write/destructive tools (read | write | destructive)
# FLARE_APPROVAL_REQUIRE_LEVEL=destructive
# FLARE_APPROVAL_BACKEND=local
# FLARE_APPROVAL_TIMEOUT=300

# Where the container finds the built SPA (Dockerfile sets this already)
# FLARE_WEB_DIST=/app/static

# Object storage for document uploads (optional)
# FLARE_OBJECT_STORE_ENDPOINT=http://localhost:9000
# FLARE_OBJECT_STORE_ACCESS_KEY=minioadmin
# FLARE_OBJECT_STORE_SECRET_KEY=minioadmin

# MCP servers (optional, JSON array)
# FLARE_MCP_SERVERS=[{"name":"echo","url":"http://localhost:9001/mcp","transport":"streamable_http","headers":{},"enabled":true}]
